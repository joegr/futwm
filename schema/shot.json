{
  "$defs": {
    "BodyPart": {
      "description": "Body part making contact with the ball.",
      "enum": [
        "left_foot",
        "right_foot",
        "head",
        "chest",
        "other"
      ],
      "title": "BodyPart",
      "type": "string"
    },
    "EventOutcome": {
      "description": "Outcome of the event from the perspective of the acting player.\n\nSemantics\n---------\nSUCCESS        : Action achieved intended effect (pass received, touch controlled).\nFAILURE        : Generic failure not captured by a more specific code.\nBLOCKED        : Shot / pass physically blocked by an opponent.\nINTERCEPTED    : Pass read and collected by an opponent.\nOUT_OF_PLAY    : Ball left the field as a result of the action.\nGOAL           : Shot resulted in a goal.\nSAVED          : Shot stopped by the goalkeeper.\nOFF_TARGET     : Shot missed the goal frame entirely.\nWON            : Duel / tackle won possession.\nLOST           : Duel / tackle lost.\nFOUL_COMMITTED : Illegal challenge committed by the acting player.",
      "enum": [
        "success",
        "failure",
        "blocked",
        "intercepted",
        "out_of_play",
        "goal",
        "saved",
        "off_target",
        "won",
        "lost",
        "foul_committed"
      ],
      "title": "EventOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Attempt on goal.",
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "description": "Ontology version",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "description": "Unique event ID (UUID4)",
      "title": "Event Id",
      "type": "string"
    },
    "timestamp": {
      "description": "Match time in seconds from kick-off",
      "minimum": 0.0,
      "title": "Timestamp",
      "type": "number"
    },
    "team": {
      "description": "Team identifier",
      "minLength": 1,
      "title": "Team",
      "type": "string"
    },
    "player": {
      "description": "Player identifier",
      "minLength": 1,
      "title": "Player",
      "type": "string"
    },
    "event_type": {
      "const": "shot",
      "default": "shot",
      "title": "Event Type",
      "type": "string"
    },
    "x": {
      "description": "Event origin x-coordinate (metres)",
      "maximum": 105.0,
      "minimum": 0,
      "title": "X",
      "type": "number"
    },
    "y": {
      "description": "Event origin y-coordinate (metres)",
      "maximum": 68.0,
      "minimum": 0,
      "title": "Y",
      "type": "number"
    },
    "sequence_id": {
      "default": 0,
      "description": "Index within possession chain",
      "minimum": 0,
      "title": "Sequence Id",
      "type": "integer"
    },
    "under_pressure": {
      "default": false,
      "description": "Opponent pressure on actor",
      "title": "Under Pressure",
      "type": "boolean"
    },
    "body_part": {
      "$ref": "#/$defs/BodyPart",
      "default": "right_foot"
    },
    "end_x": {
      "description": "Goal-frame target x",
      "maximum": 105.0,
      "minimum": 0,
      "title": "End X",
      "type": "number"
    },
    "end_y": {
      "description": "Goal-frame target y",
      "maximum": 68.0,
      "minimum": 0,
      "title": "End Y",
      "type": "number"
    },
    "end_z": {
      "default": 1.0,
      "description": "Height at goal line (metres)",
      "maximum": 5.0,
      "minimum": 0.0,
      "title": "End Z",
      "type": "number"
    },
    "xg": {
      "default": 0.0,
      "description": "Expected goals value",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Xg",
      "type": "number"
    },
    "outcome": {
      "$ref": "#/$defs/EventOutcome",
      "default": "off_target"
    },
    "first_time": {
      "default": false,
      "description": "Shot without preceding touch",
      "title": "First Time",
      "type": "boolean"
    }
  },
  "required": [
    "timestamp",
    "team",
    "player",
    "x",
    "y",
    "end_x",
    "end_y"
  ],
  "title": "ShotEvent",
  "type": "object"
}