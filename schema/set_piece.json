{
  "$defs": {
    "EventOutcome": {
      "description": "Outcome of the event from the perspective of the acting player.\n\nSemantics\n---------\nSUCCESS        : Action achieved intended effect (pass received, touch controlled).\nFAILURE        : Generic failure not captured by a more specific code.\nBLOCKED        : Shot / pass physically blocked by an opponent.\nINTERCEPTED    : Pass read and collected by an opponent.\nOUT_OF_PLAY    : Ball left the field as a result of the action.\nGOAL           : Shot resulted in a goal.\nSAVED          : Shot stopped by the goalkeeper.\nOFF_TARGET     : Shot missed the goal frame entirely.\nWON            : Duel / tackle won possession.\nLOST           : Duel / tackle lost.\nFOUL_COMMITTED : Illegal challenge committed by the acting player.",
      "enum": [
        "success",
        "failure",
        "blocked",
        "intercepted",
        "out_of_play",
        "goal",
        "saved",
        "off_target",
        "won",
        "lost",
        "foul_committed"
      ],
      "title": "EventOutcome",
      "type": "string"
    },
    "Foot": {
      "description": "Foot used for the action.",
      "enum": [
        "left",
        "right",
        "both"
      ],
      "title": "Foot",
      "type": "string"
    },
    "SetPieceType": {
      "description": "Dead-ball restart type.",
      "enum": [
        "corner_kick",
        "free_kick",
        "penalty",
        "throw_in",
        "goal_kick",
        "kick_off"
      ],
      "title": "SetPieceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Dead-ball restart.",
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "description": "Ontology version",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "description": "Unique event ID (UUID4)",
      "title": "Event Id",
      "type": "string"
    },
    "timestamp": {
      "description": "Match time in seconds from kick-off",
      "minimum": 0.0,
      "title": "Timestamp",
      "type": "number"
    },
    "team": {
      "description": "Team identifier",
      "minLength": 1,
      "title": "Team",
      "type": "string"
    },
    "player": {
      "description": "Player identifier",
      "minLength": 1,
      "title": "Player",
      "type": "string"
    },
    "event_type": {
      "const": "set_piece",
      "default": "set_piece",
      "title": "Event Type",
      "type": "string"
    },
    "x": {
      "description": "Event origin x-coordinate (metres)",
      "maximum": 105.0,
      "minimum": 0,
      "title": "X",
      "type": "number"
    },
    "y": {
      "description": "Event origin y-coordinate (metres)",
      "maximum": 68.0,
      "minimum": 0,
      "title": "Y",
      "type": "number"
    },
    "sequence_id": {
      "default": 0,
      "description": "Index within possession chain",
      "minimum": 0,
      "title": "Sequence Id",
      "type": "integer"
    },
    "under_pressure": {
      "default": false,
      "description": "Opponent pressure on actor",
      "title": "Under Pressure",
      "type": "boolean"
    },
    "set_piece_type": {
      "$ref": "#/$defs/SetPieceType",
      "default": "free_kick"
    },
    "foot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Foot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "to_player": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Primary recipient",
      "title": "To Player"
    },
    "end_x": {
      "anyOf": [
        {
          "description": "x-coordinate on pitch (metres, 0\u2013105)",
          "maximum": 105.0,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Delivery target x",
      "title": "End X"
    },
    "end_y": {
      "anyOf": [
        {
          "description": "y-coordinate on pitch (metres, 0\u201368)",
          "maximum": 68.0,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Delivery target y",
      "title": "End Y"
    },
    "outcome": {
      "$ref": "#/$defs/EventOutcome",
      "default": "success"
    }
  },
  "required": [
    "timestamp",
    "team",
    "player",
    "x",
    "y"
  ],
  "title": "SetPieceEvent",
  "type": "object"
}